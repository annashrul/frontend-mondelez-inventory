# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Semua variabel wajib berawalan VITE_ agar terbaca di browser.

# URL relatif: proxy Vite saat development dan rewrite Vercel saat produksi.
VITE_API_URL=/api/v1

# Alamat server Socket.io (kosongkan = otomatis dari VITE_API_URL).
VITE_SOCKET_URL=

# Timeout request API biasa (milidetik)
VITE_API_TIMEOUT=10000

# Timeout khusus cari barang pakai gambar (milidetik)
VITE_AI_SEARCH_TIMEOUT=120000

# Timeout khusus simpan barang bergambar / embedding (milidetik)
VITE_UPLOAD_TIMEOUT=180000

# 'true' = pakai data mock, 'false' = pakai backend asli
VITE_USE_MOCKS=false

# Timeout khusus submit pengambilan barang (ms).
VITE_WITHDRAWAL_TIMEOUT=120000
