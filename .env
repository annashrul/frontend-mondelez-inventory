# ============================================================
# Konfigurasi environment frontend (Vite)
# Semua variabel wajib berawalan VITE_ agar terbaca di browser
# lewat import.meta.env. File ini juga dipakai oleh vite.config.js
# (lihat VITE_PROXY_TARGET) saat menjalankan `npm run dev`.
# ============================================================

# Base path API untuk semua pemanggilan (src/services/api.js).
# Relatif (/api/v1) = browser memanggil origin halaman, lalu proxy Vite
# meneruskannya ke VITE_PROXY_TARGET. Ini yang benar untuk dev lokal maupun
# akses dari HP lewat ngrok (cukup tunnel frontend 5173), karena browser tidak
# pernah menyentuh localhost backend secara langsung.
# Jangan isi absolut (http://localhost:5000/...) bila diakses dari perangkat
# lain: 'localhost' akan menunjuk ke perangkat itu sendiri dan request timeout.
VITE_API_URL=/api/v1

# Alamat backend yang dipakai proxy Vite untuk /api dan /socket.io
VITE_PROXY_TARGET=http://localhost:5000

# Alamat server Socket.io untuk notifikasi realtime.
# Biarkan kosong agar otomatis memakai host dari VITE_API_URL (ikut proxy).
VITE_SOCKET_URL=

# Timeout request API biasa (milidetik)
VITE_API_TIMEOUT=10000

# Timeout khusus cari barang pakai gambar. Model embedding di backend bisa
# butuh 30-60 detik, jadi jangan disamakan dengan timeout request biasa.
VITE_AI_SEARCH_TIMEOUT=120000

# Timeout khusus simpan barang bergambar (embedding + upload storage).
VITE_UPLOAD_TIMEOUT=180000

# 'true' = pakai data mock (tanpa backend), 'false' = pakai backend asli
VITE_USE_MOCKS=false
