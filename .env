# Konfigurasi environment frontend (Vite).
# Semua variabel wajib berawalan VITE_ agar terbaca di browser.

# URL API langsung ke backend, tanpa proxy Vite.
VITE_API_URL=https://saint-insulin-chapel-monte.trycloudflare.com/api/v1

# Kosongkan agar Socket.io otomatis memakai host dari VITE_API_URL.
VITE_SOCKET_URL=

# Timeout request API biasa (milidetik)
VITE_API_TIMEOUT=10000

# Timeout khusus cari barang pakai gambar. Model embedding di backend bisa
# butuh 30-60 detik, jadi jangan disamakan dengan timeout request biasa.
VITE_AI_SEARCH_TIMEOUT=120000

# Timeout khusus simpan barang bergambar (embedding + upload storage).
VITE_UPLOAD_TIMEOUT=180000

# 'true' = pakai data mock (tanpa backend), 'false' = pakai backend asli
VITE_USE_MOCKS=false
